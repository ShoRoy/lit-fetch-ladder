{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_lit-fetch-ladder_.*|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|Bash|PowerShell|Monitor|WebFetch|mcp__.*__zotero_(delete_item|delete_collection|delete_annotation|merge_duplicates|batch_update|switch_library|manage_note|update_item|set_item_collections|set_item_parent|update_collection|update_annotation|remove_item_relation|authorize_local_writes|attach_file|add_item)",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/guard/guard.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_lit-fetch-ladder_library__browser_(navigate|navigate_back|tabs|click|drag|drop|fill_form|handle_dialog|hover|press_key|select_option|type|mouse_.*)",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/guard/guard.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__plugin_lit-fetch-ladder_library__browser_(navigate|navigate_back|tabs|click|drag|drop|fill_form|handle_dialog|hover|press_key|select_option|type|mouse_.*)",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/guard/guard.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
